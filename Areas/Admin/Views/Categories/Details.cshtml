@model MyStore.Models.Category

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Chi tiết danh mục</h2>
 @Html.Partial("PVProductInfo", Model)
<div>
    <dl class="dl-horizontal ">
        <dt>
            @*Html.DisplayNameFor(model => model.CategoryName)*@
            Tên danh mục
        </dt>
        @*giá trị của trường CategoryName*@
        <dd>
            @Html.DisplayFor(model => model.CategoryName)
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Cập Nhật", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary " })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary " })
</p>
