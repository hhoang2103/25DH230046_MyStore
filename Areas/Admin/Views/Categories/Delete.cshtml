@model MyStore.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Xóa danh mục</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
<div class="form-horizontal">
    <h4>Bạn thực sự muốn xóa danh mục này?</h4>
    @Html.Partial("PVProductInfo", Model)

</div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <div class="col-md-10">
                @*hiển thị giá trị của categoryname*@
                @Html.DisplayFor(model => model.ProductDecription)
            </div>



            <input type="submit" value="Xóa" class="btn btn-primary" /> |
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary " })
        </div>
        }
    </div>
}

